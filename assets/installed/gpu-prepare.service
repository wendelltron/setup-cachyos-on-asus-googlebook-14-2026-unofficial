[Unit]
Description=Prepare ASUS Lapis graphics using the verified driver sequence
Wants=systemd-udev-settle.service
After=systemd-udev-settle.service local-fs.target NetworkManager.service
Before=display-manager.service
ConditionPathExists=/etc/cachyos-boot/install.json

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=90
ExecStart=/usr/local/libexec/cachyos-gpu-prepare
ExecStartPost=-/usr/bin/modprobe snd_sof_pci_intel_ptl

[Install]
WantedBy=graphical.target
